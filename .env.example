# Firebase Client Configuration (Safe for client-side exposure via EXPO_PUBLIC_*)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# AI Backend Service URL (Protected Firebase Function or Cloud Run endpoint)
EXPO_PUBLIC_AI_API_URL=https://us-central1-your-project-id.cloudfunctions.net/estimateMealCalories
